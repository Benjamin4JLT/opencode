# OpenCode Container Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# AI Provider Configuration
# =============================================================================
# At least one AI provider API key is required for OpenCode to function

# Anthropic (Claude) - Recommended
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (GPT-4, etc.)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google (Gemini)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# =============================================================================
# Application Configuration
# =============================================================================

# Environment mode
NODE_ENV=production

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Application port (internal)
APP_PORT=8080

# Console/UI port (if applicable)
CONSOLE_PORT=3000

# =============================================================================
# Web Terminal Configuration
# =============================================================================

# ttyd port for web-based terminal access
TTYD_PORT=7681

# Basic authentication for web terminal (format: username:password)
# SECURITY: Change this from default!
TTYD_CREDENTIALS=admin:changeme

# Allow write access in terminal (true/false)
TTYD_WRITABLE=true

# =============================================================================
# OpenCode Specific Configuration
# =============================================================================

# OpenCode data directory (usually auto-detected)
# OPENCODE_DATA_DIR=/home/opencode/.opencode

# OpenCode config directory
# OPENCODE_CONFIG_DIR=/home/opencode/.config/opencode

# Default AI provider (anthropic, openai, google)
# OPENCODE_DEFAULT_PROVIDER=anthropic

# Default model
# OPENCODE_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# LSP (Language Server Protocol) Configuration
# =============================================================================

# LSP server port (if needed)
# LSP_PORT=6060

# Enable LSP features
# LSP_ENABLED=true

# =============================================================================
# Security Configuration
# =============================================================================

# Enable/disable features for security
# ALLOW_NETWORK=true
# ALLOW_FILE_SYSTEM=true

# Max file size for processing (in MB)
# MAX_FILE_SIZE=10

# =============================================================================
# Database Configuration (if applicable)
# =============================================================================

# If OpenCode uses a database for persistence
# DATABASE_URL=postgresql://user:password@localhost:5432/opencode
# DATABASE_SSL=false

# =============================================================================
# Storage Configuration
# =============================================================================

# Where to store persistent data
# DATA_DIR=/app/data

# Where to store logs
# LOG_DIR=/app/logs

# =============================================================================
# Performance Configuration
# =============================================================================

# Bun runtime options
# BUN_ENV=production
# BUN_RUNTIME_TRANSPILER_CACHE=1

# Memory limits (optional)
# NODE_OPTIONS=--max-old-space-size=2048

# =============================================================================
# Monitoring & Telemetry
# =============================================================================

# Enable telemetry (if applicable)
# TELEMETRY_ENABLED=false

# Custom metrics endpoint
# METRICS_ENDPOINT=

# Health check configuration
# HEALTH_CHECK_PORT=8080
# HEALTH_CHECK_PATH=/health

# =============================================================================
# Development Options (for local development)
# =============================================================================

# Enable debug mode
# DEBUG=*

# Enable hot reload
# WATCH=true

# Development mode
# DEV=true

# =============================================================================
# Custom Configuration
# =============================================================================

# Add any custom environment variables below:


